# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_telegram_numeric_chat_id_here
# Optional secret token to verify requests from Telegram
TELEGRAM_WEBHOOK_SECRET=your_optional_secret_token

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Calendar Integration
# Use 'primary' or your Google account email (e.g., user@gmail.com), NOT the embed URL!
GOOGLE_CALENDAR_ID=primary

# Localization
TIMEZONE=Asia/Tehran

